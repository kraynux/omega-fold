/* Regles communes aux 4 profils de rendu. Portees verbatim depuis
   omega-scan/omega-stress (D-007, D-008 : meme catalogue de themes,
   memes conventions visuelles pour toute la suite omega-).

   Boutons : patron porte tel quel. Le contour rond vit EXCLUSIVEMENT sur
   ".omega-btn-frame" (un Container), jamais sur le Button lui-meme
   ("border: none" partout) : remplir le fond d'un widget au survol/focus
   peint TOUJOURS tout son rectangle, y compris l'anneau de bordure round
   — separer decoration (frame, jamais recolore) et interactivite (Button,
   fond $accent au survol/focus) evite ce bug tout en gardant un focus
   colore selon le theme. ".omega-actions"/".omega-confirm-buttons" ne
   portent PAS de contour a eux : le bouton est deja entoure par son
   propre frame, un deuxieme cadre autour du groupe est redondant. */

Screen {
    background: $background;
    color: $foreground;
}

.omega-title {
    text-style: bold;
    color: $primary;
    border: round $accent;
    padding: 0 1;
    width: auto;
    margin: 1 0;
}

.omega-subtitle {
    color: $secondary;
    padding: 0 0 1 0;
}

.omega-hint {
    color: $foreground 60%;
    padding: 0 0 1 0;
}

.omega-hidden {
    display: none;
}

.omega-panel {
    padding: 1 2;
    height: 1fr;
    overflow-y: auto;
}

.omega-form-panel {
    width: 1fr;
    padding: 1 2;
    height: 1fr;
    align: center top;
    overflow-y: auto;
}

.omega-form-panel > Select,
.omega-form-panel > Input {
    width: 70;
    margin-bottom: 1;
}

.omega-form-panel .omega-title,
.omega-form-panel .omega-subtitle,
.omega-form-panel .omega-hint {
    width: 70;
}

.omega-form-panel .omega-title {
    content-align: center middle;
}

.omega-form-panel > .omega-actions {
    width: 70;
    align: center middle;
    height: auto;
}

/* Rangee de deux champs cote a cote (ex. Type+Mode, Profondeur+Pages) ou
   d'un libelle + interrupteur (ex. Respecter robots.txt) — largeur fixe
   70 comme tout le reste du formulaire, sans quoi une rangee non
   contrainte casse le centrage groupe de TOUS les enfants du panneau
   (Textual centre le groupe d'enfants comme un bloc, pas individuellement :
   un seul enfant non contraint en largeur suffit a ramener tout le
   groupe a gauche). */
.omega-form-panel .omega-form-row {
    width: 70;
    height: auto;
    align: left middle;
    margin-bottom: 1;
}

.omega-form-panel .omega-form-row-item,
.omega-form-panel .omega-form-row-item-last {
    width: 34;
    height: auto;
}

.omega-form-panel .omega-form-row-item {
    margin-right: 2;
}

.omega-form-panel .omega-form-row-item Input,
.omega-form-panel .omega-form-row-item Select,
.omega-form-panel .omega-form-row-item-last Input,
.omega-form-panel .omega-form-row-item-last Select {
    width: 1fr;
    margin-bottom: 0;
}

/* Etiquette explicite AU-DESSUS de chaque champ groupe (Type/Mode,
   Profondeur/Pages, Delai/User-Agent) — sans elle, un champ pre-rempli
   d'une valeur par defaut (ex. "5") n'indique nulle part ce qu'il
   represente : le `placeholder` d'un Input ne s'affiche QUE si le champ
   est vide, invisible des qu'une valeur y est deja posee (bug d'UX reel
   signale par l'utilisateur). */
.omega-field-label {
    color: $secondary;
    height: 1;
}

.omega-form-panel .omega-switch-label {
    width: auto;
    margin-right: 2;
    color: $secondary;
}

.omega-home-root {
    align: center middle;
    height: 1fr;
    overflow-y: auto;
}

.omega-splash-middle {
    width: 1fr;
}

.omega-splash-hero {
    color: $accent;
    text-align: left;
    width: auto;
}

.omega-splash-prompt {
    color: $secondary;
    width: auto;
    margin-top: 1;
    text-style: italic;
}

.omega-home-wordmark {
    width: auto;
    text-align: left;
    padding-bottom: 1;
}

.omega-home-menu {
    background: $panel;
    border: round $accent;
    border-title-align: center;
    border-title-color: $background;
    border-title-background: $accent;
    border-title-style: bold;
    padding: 1 4;
    width: auto;
    height: auto;
}

.omega-actions {
    align: left middle;
    height: auto;
    width: auto;
    margin-top: 1;
    overflow-x: auto;
}

.omega-btn-frame {
    border: round $accent;
    padding: 0;
    width: auto;
    height: auto;
}

.omega-home-menu .omega-btn-frame {
    width: 32;
    height: 3;
    margin-bottom: 1;
}

.omega-actions Button,
.omega-confirm-buttons Button,
.omega-home-menu Button {
    background: $surface;
    border: none;
    color: $foreground;
    min-width: 10;
}

.omega-home-menu Button {
    width: 100%;
    height: 100%;
    min-width: 0;
}

.omega-actions Button.-primary,
.omega-confirm-buttons Button.-primary {
    background: $surface;
    border: none;
    color: $primary;
}

.omega-actions Button.-error,
.omega-confirm-buttons Button.-error {
    background: $surface;
    border: none;
    color: $error;
}

.omega-actions Button:hover,
.omega-confirm-buttons Button:hover,
.omega-home-menu Button:hover,
.omega-actions Button:focus,
.omega-confirm-buttons Button:focus,
.omega-home-menu Button:focus {
    background: $accent;
    color: $background;
    text-style: bold;
}

.omega-actions Button.-error:hover,
.omega-confirm-buttons Button.-error:hover,
.omega-actions Button.-error:focus,
.omega-confirm-buttons Button.-error:focus {
    background: $error;
    color: $background;
    text-style: bold;
}

.omega-confirm-box {
    width: 60;
    height: auto;
    border: round $accent;
    padding: 1 2;
    align: center middle;
}

.omega-confirm-title {
    text-style: bold;
    color: $error;
    width: 60;
    content-align: center middle;
    margin-bottom: 1;
}

.omega-confirm-buttons {
    width: 60;
    height: auto;
    align: center middle;
}

.omega-progress-panel {
    align: center middle;
    width: 1fr;
    height: 1fr;
}

.omega-progress-panel > Static {
    width: auto;
}

.omega-progress-panel LoadingIndicator {
    width: auto;
    height: 3;
}

.omega-progress-log {
    width: 80%;
    max-width: 120;
    height: 12;
    margin-top: 1;
    border: round $accent;
    background: $surface;
    color: $foreground 80%;
}

.omega-modal {
    width: 80%;
    max-width: 100;
    border: round $primary;
    padding: 1 2;
    background: $surface;
}

.omega-role-badge {
    text-style: bold;
    padding: 0 1;
    margin: 0 0 1 0;
}

.omega-state-open { background: $success; color: $background; }
.omega-state-closed { background: $panel; color: $foreground; }
.omega-state-filtered { background: $warning; color: $background; }

DataTable {
    height: 1fr;
}

#profile-table {
    height: 10;
}

ToggleButton > .toggle--button {
    color: $foreground;
    text-style: dim;
}

ToggleButton.-on > .toggle--button {
    color: $success;
    text-style: bold;
}
